# Required public browser configuration for YOUR Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is also supported; never use a secret/service-role key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only manual Sheets import source.
# {"url":"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit","mappings":[{"sheet":"YOUR_TAB","account_id":"YOUR_ACCOUNT_UUID","selected":true}]}
FINANCE_SHEET_IMPORT_SOURCE=

# Optional server-only Google service-account JSON. Grant this account access
# only to your intercompany workbook; never give this value a NEXT_PUBLIC_ name.
FINANCE_GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional scheduled sheet sync only: 32 random bytes as 64 lowercase hex chars.
# Register its SHA-256 digest in your private source registry. See docs/SHEET_SYNC.md.
FINANCE_SHEET_SYNC_TOKEN=

# Optional Clobe OAuth: 32 random bytes as standard base64 (44 characters).
# Keep stable: it encrypts this installation's OAuth connection.
CLOBE_TOKEN_ENCRYPTION_KEY=
# Your deployed callback, for example https://finance.example.com/api/clobe/callback
# Local development uses an isolated DB and its own registered OAuth client.
CLOBE_OAUTH_REDIRECT_URL=
# Server-only verifier provisioned from YOUR private.fd_clobe_import_verifier
# singleton over a trusted DB connection. Never print or expose it via an RPC.
# Used by Clobe imports/balances and Toss settlement signatures.
CLOBE_IMPORT_SIGNING_KEY=

# Optional Toss Payments settlement reader: explicitly map YOUR MIDs to existing
# business and receiving account UUIDs. Multiple keys can use distinct env names.
# [{"merchantId":"YOUR_MID","businessId":"YOUR_BUSINESS_UUID","accountId":"YOUR_ACCOUNT_UUID","label":"Example shop","secretKeyEnv":"TOSS_SECRET_KEY"}]
TOSS_SETTLEMENT_MERCHANTS=
TOSS_SECRET_KEY=
# Your app origin, for example https://finance.example.com (no path).
# A configured Clobe callback origin is the fallback; no shared default exists.
TOSS_SYNC_ORIGIN=
